{
    "name": "kode/context",
    "description": "轻量级、高性能的 PHP 协程/纤程上下文管理库，支持分布式多机器部署与 W3C Trace Context 标准",
    "keywords": ["context", "coroutine", "fiber", "swoole", "swow", "request-context", "php83", "distributed", "tracing", "opentelemetry", "w3c-trace-context", "上下文", "协程", "纤程", "分布式", "链路追踪"],
    "homepage": "https://github.com/kodephp/context",
    "license": "Apache-2.0",
    "version": "3.1.1",
    "authors": [
        {
            "name": "KodePHP",
            "email": "382601296@qq.com"
        }
    ],
    "support": {
        "issues": "https://github.com/kodephp/context/issues",
        "source": "https://github.com/kodephp/context"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.11 || ^2.0"
    },
    "suggest": {
        "ext-pcntl": "启用多进程上下文继承与进程池能力",
        "ext-parallel": "启用多线程（ZTS）上下文隔离能力",
        "ext-swoole": "启用 Swoole 协程上下文隔离",
        "ext-swow": "启用 Swow 协程上下文隔离"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Context\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Context\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse src tests --level=max --memory-limit=1G",
        "benchmark": "php benchmark.php",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
